# Push delivery worker (workers/push-delivery-worker.ts) — production env on the VPS.
# Only vars the worker process actually reads. Do not copy the full app
# .env.example here; this process never touches Stripe/Resend/Mistral/OpenAI.

# Supabase (service-role client only — worker never uses the anon key)
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Web Push (must match the VAPID keys the Next.js app was deployed with)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:notifications@pomocnik.net

# Worker tuning (optional, defaults shown)
PUSH_WORKER_INTERVAL_MS=5000
PUSH_WORKER_BATCH_SIZE=25
